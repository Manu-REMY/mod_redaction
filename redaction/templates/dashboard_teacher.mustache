{{!
    @template mod_redaction/dashboard_teacher

    Teacher dashboard for viewing submission statistics and AI feedback synthesis.

    Context variables required for this template:
    * cmid - Course module ID
    * ai_enabled - Whether AI is enabled
    * stats - Submission statistics object
    * summary - AI summary object (optional)
    * token_stats - Token usage statistics

    Example context (json):
    {
        "cmid": 123,
        "ai_enabled": true,
        "stats": {
            "total_expected": 25,
            "submitted": 20,
            "graded": 15,
            "submitted_percent": 80,
            "graded_percent": 60,
            "average_grade": 13.5
        }
    }
}}

<div class="mod_redaction-dashboard" data-cmid="{{cmid}}" data-mod-redaction-dashboard data-groupid="{{groupid}}">
    <div class="row">
    {{! Submission Progress Section — left column }}
    <div class="{{#token_stats}}{{#ai_enabled}}col-lg-9 col-md-12{{/ai_enabled}}{{^ai_enabled}}col-12{{/ai_enabled}}{{/token_stats}}{{^token_stats}}col-12{{/token_stats}} mb-3">
    <div class="card h-100 mod_redaction-dash-card">
        <div class="card-header bg-primary text-white mod_redaction-dash-card-header">
            <h5 class="mb-0 mod_redaction-dash-card-title">
                <i class="fa fa-chart-bar mr-2"></i>
                {{#str}}dashboard_progress, mod_redaction{{/str}}
            </h5>
        </div>
        <div class="card-body d-flex flex-column mod_redaction-dash-card-body">
            <div class="row align-items-stretch flex-grow-1 mod_redaction-dash-row">
                {{! Progress Stats — left half }}
                <div class="col-lg-6 col-md-12 d-flex flex-column justify-content-center">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="mod_redaction-dash-progress-label">{{#str}}dashboard_submitted, mod_redaction{{/str}}</span>
                        <strong class="mod_redaction-dash-progress-label">{{stats.submitted}} / {{stats.total_expected}} ({{stats.submitted_percent}}%)</strong>
                    </div>
                    <div class="progress mb-3 mod_redaction-dash-progress">
                        <div class="progress-bar bg-info mod_redaction-dash-progress-bar" role="progressbar"
                             style="width: {{stats.submitted_percent}}%;"
                             aria-valuenow="{{stats.submitted_percent}}"
                             aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mb-1">
                        <span class="mod_redaction-dash-progress-label">{{#str}}dashboard_graded, mod_redaction{{/str}}</span>
                        <strong class="mod_redaction-dash-progress-label">{{stats.graded}} / {{stats.total_expected}} ({{stats.graded_percent}}%)</strong>
                    </div>
                    <div class="progress mb-3 mod_redaction-dash-progress">
                        <div class="progress-bar bg-success mod_redaction-dash-progress-bar" role="progressbar"
                             style="width: {{stats.graded_percent}}%;"
                             aria-valuenow="{{stats.graded_percent}}"
                             aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>

                    {{#ai_enabled}}
                    <div class="p-2 bg-light rounded d-flex flex-wrap align-items-center mod_redaction-dash-ai-badges">
                        <i class="fa fa-robot text-muted" aria-hidden="true"></i>
                        <span class="badge badge-warning">{{stats.ai_pending}} {{#str}}dashboard_pending, mod_redaction{{/str}}</span>
                        <span class="badge badge-success">{{stats.ai_completed}} {{#str}}dashboard_completed, mod_redaction{{/str}}</span>
                        <span class="badge badge-info">{{stats.ai_applied}} {{#str}}dashboard_applied, mod_redaction{{/str}}</span>
                    </div>
                    {{/ai_enabled}}
                </div>

                {{! Average Grade — middle, vertically centered }}
                <div class="col-lg-3 col-md-6 d-flex align-items-center justify-content-center">
                    {{#stats.average_grade}}
                    <div class="text-center">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mod_redaction-dash-average-circle">
                            <div>
                                <div class="mod_redaction-dash-average-value">{{stats.average_grade}}<small class="mod_redaction-dash-average-max">/20</small></div>
                                <div class="text-muted mod_redaction-dash-average-label">{{#str}}dashboard_average, mod_redaction{{/str}}</div>
                            </div>
                        </div>
                    </div>
                    {{/stats.average_grade}}
                    {{^stats.average_grade}}
                    <div class="text-center text-muted">
                        <i class="fa fa-minus-circle fa-3x mb-2"></i>
                        <p class="mb-0 mod_redaction-dash-no-grades">{{#str}}dashboard_no_grades, mod_redaction{{/str}}</p>
                    </div>
                    {{/stats.average_grade}}
                </div>

                {{! Grade Distribution — right, taller chart }}
                <div class="col-lg-3 col-md-6 d-flex flex-column">
                    <div class="chart-container flex-grow-1 mod_redaction-dash-chart">
                        <canvas id="gradeDistributionChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>{{! end progress column }}

    {{#ai_enabled}}
    {{#token_stats}}
    {{! Token Usage Section — right column, side by side with progress }}
    <div class="col-lg-3 col-md-12 mb-3">
        <div class="card h-100 mod_redaction-dash-card">
            <div class="card-header mod_redaction-dash-card-header mod_redaction-dash-card-header-light">
                <h5 class="mb-0 mod_redaction-dash-card-title mod_redaction-dash-card-title-muted">
                    <i class="fa fa-coins mr-2"></i>
                    {{#str}}dashboard_token_usage, mod_redaction{{/str}}
                </h5>
            </div>
            <div class="card-body py-3">
                <div class="d-flex flex-column mod_redaction-dash-token-list">
                    <div class="rounded p-2 text-center mod_redaction-dash-token-stat">
                        <h4 class="mb-0 mod_redaction-dash-token-value">{{token_stats.total_tokens}}</h4>
                        <small class="text-muted mod_redaction-dash-token-label">{{#str}}dashboard_total_tokens, mod_redaction{{/str}}</small>
                    </div>
                    <div class="rounded p-2 text-center mod_redaction-dash-token-stat">
                        <h4 class="mb-0 mod_redaction-dash-token-value">{{token_stats.prompt_tokens}}</h4>
                        <small class="text-muted mod_redaction-dash-token-label">{{#str}}dashboard_prompt_tokens, mod_redaction{{/str}}</small>
                    </div>
                    <div class="rounded p-2 text-center mod_redaction-dash-token-stat">
                        <h4 class="mb-0 mod_redaction-dash-token-value">{{token_stats.completion_tokens}}</h4>
                        <small class="text-muted mod_redaction-dash-token-label">{{#str}}dashboard_completion_tokens, mod_redaction{{/str}}</small>
                    </div>
                    <div class="rounded p-2 text-center mod_redaction-dash-token-stat">
                        <h4 class="mb-0 mod_redaction-dash-token-value">{{token_stats.evaluation_count}}</h4>
                        <small class="text-muted mod_redaction-dash-token-label">{{#str}}dashboard_evaluations, mod_redaction{{/str}}</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{/token_stats}}
    {{/ai_enabled}}
    </div>{{! end .row container }}

    {{#ai_enabled}}
    {{! AI Summary Section — full width below }}
    <div class="card mb-3 mod_redaction-dash-card">
        <div class="card-header d-flex justify-content-between align-items-center mod_redaction-dash-card-header mod_redaction-dash-card-header-ai">
            <h5 class="mb-0 mod_redaction-dash-card-title">
                <i class="fa fa-brain mr-2"></i>
                {{#str}}dashboard_ai_summary, mod_redaction{{/str}}
            </h5>
            <button type="button" class="btn btn-sm btn-light mod_redaction-dash-refresh-btn" id="refreshSummaryBtn" data-cmid="{{cmid}}">
                <i class="fa fa-sync-alt mr-1"></i>
                {{#str}}dashboard_refresh, mod_redaction{{/str}}
            </button>
        </div>
        <div class="card-body py-3" id="aiSummaryContent">
            {{#summary}}
            <div class="row">
                {{! Difficulties }}
                <div class="col-lg-4 col-md-4 mb-3 mb-lg-0">
                    <div class="h-100 mod_redaction-dash-summary-box mod_redaction-dash-summary-difficulties">
                        <div class="px-3 py-2 mod_redaction-dash-summary-head">
                            <strong class="mod_redaction-dash-summary-title">
                                <i class="fa fa-exclamation-triangle mr-1"></i>
                                {{#str}}dashboard_difficulties, mod_redaction{{/str}}
                            </strong>
                        </div>
                        <ul class="list-unstyled mb-0 px-3 py-2 mod_redaction-dash-summary-list">
                            {{#summary.difficulties}}
                            <li class="mb-2">
                                <i class="fa fa-times-circle text-danger mr-1 mod_redaction-dash-summary-icon"></i>
                                {{.}}
                            </li>
                            {{/summary.difficulties}}
                            {{^summary.difficulties}}
                            <li class="text-muted">{{#str}}dashboard_no_difficulties, mod_redaction{{/str}}</li>
                            {{/summary.difficulties}}
                        </ul>
                    </div>
                </div>

                {{! Strengths }}
                <div class="col-lg-4 col-md-4 mb-3 mb-lg-0">
                    <div class="h-100 mod_redaction-dash-summary-box mod_redaction-dash-summary-strengths">
                        <div class="px-3 py-2 mod_redaction-dash-summary-head">
                            <strong class="mod_redaction-dash-summary-title">
                                <i class="fa fa-check-circle mr-1"></i>
                                {{#str}}dashboard_strengths, mod_redaction{{/str}}
                            </strong>
                        </div>
                        <ul class="list-unstyled mb-0 px-3 py-2 mod_redaction-dash-summary-list">
                            {{#summary.strengths}}
                            <li class="mb-2">
                                <i class="fa fa-check-circle text-success mr-1 mod_redaction-dash-summary-icon"></i>
                                {{.}}
                            </li>
                            {{/summary.strengths}}
                            {{^summary.strengths}}
                            <li class="text-muted">{{#str}}dashboard_no_strengths, mod_redaction{{/str}}</li>
                            {{/summary.strengths}}
                        </ul>
                    </div>
                </div>

                {{! Recommendations }}
                <div class="col-lg-4 col-md-4">
                    <div class="h-100 mod_redaction-dash-summary-box mod_redaction-dash-summary-recommendations">
                        <div class="px-3 py-2 mod_redaction-dash-summary-head">
                            <strong class="mod_redaction-dash-summary-title">
                                <i class="fa fa-lightbulb mr-1"></i>
                                {{#str}}dashboard_recommendations, mod_redaction{{/str}}
                            </strong>
                        </div>
                        <ul class="list-unstyled mb-0 px-3 py-2 mod_redaction-dash-summary-list">
                            {{#summary.recommendations}}
                            <li class="mb-2">
                                <i class="fa fa-arrow-right text-info mr-1 mod_redaction-dash-summary-icon"></i>
                                {{.}}
                            </li>
                            {{/summary.recommendations}}
                            {{^summary.recommendations}}
                            <li class="text-muted">{{#str}}dashboard_no_recommendations, mod_redaction{{/str}}</li>
                            {{/summary.recommendations}}
                        </ul>
                    </div>
                </div>
            </div>

            {{#summary.general_observation}}
            <div class="mt-3 p-2 rounded mod_redaction-dash-observation">
                <strong><i class="fa fa-comment mr-1 text-muted"></i> {{#str}}dashboard_observation, mod_redaction{{/str}}:</strong>
                {{summary.general_observation}}
            </div>
            {{/summary.general_observation}}

            <div class="mt-2 text-right">
                <small class="text-muted mod_redaction-dash-meta">
                    <i class="fa fa-clock mr-1"></i>
                    {{#str}}dashboard_analyzed, mod_redaction{{/str}}: {{summary.submissions_analyzed}} {{#str}}dashboard_submissions, mod_redaction{{/str}}
                    {{#summary.provider}}
                    | {{#str}}dashboard_provider, mod_redaction{{/str}}: {{summary.provider}}
                    {{/summary.provider}}
                </small>
            </div>
            {{/summary}}

            {{^summary}}
            <div class="text-center py-3 text-muted">
                <i class="fa fa-info-circle fa-2x mb-2"></i>
                <p class="mb-1 mod_redaction-dash-no-summary">{{#str}}dashboard_no_summary, mod_redaction{{/str}}</p>
                <p class="small mb-0">{{#str}}dashboard_summary_hint, mod_redaction{{/str}}</p>
            </div>
            {{/summary}}
        </div>
    </div>

    {{/ai_enabled}}
</div>

{{#js}}
require(['mod_redaction/dashboard'], function(Dashboard) {
    Dashboard.init({{cmid}}, {{{grade_distribution_json}}});
});
{{/js}}
