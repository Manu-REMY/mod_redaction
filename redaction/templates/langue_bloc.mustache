{{!
    @template mod_redaction/langue_bloc

    Language assessment of one correction: the four levels in words and letters, then the mistakes.

    Context variables required for this template:
    * titre - Title with the points of the language part
    * paliers - dimension, mot, sigle, bas (TI or I)
    * hasfautes, fautes - cite (already quoted), correction, hastype, type, hasfois, fois
    * hasremarques, remarques - cite (already quoted), hastype, type
    * hasecartees, ecartees - Teacher only: quotes of the AI not found in the text

    Example context (json):
    {
        "titre": "Maîtrise de la langue : 1,3/2",
        "paliers": [{"dimension": "Orthographe", "mot": "Insuffisant", "sigle": "I", "bas": true},
            {"dimension": "Syntaxe", "mot": "Satisfaisant", "sigle": "S", "bas": false}],
        "hasfautes": true,
        "fautes": [{"cite": "« fonctionnemant »", "correction": "fonctionnement", "hastype": true, "type": "orthographe d'usage",
            "hasfois": false, "fois": ""}],
        "hasremarques": true,
        "remarques": [{"cite": "« le moteur et la roue tourne »", "hastype": true, "type": "phrase mal construite"}],
        "hasecartees": false,
        "ecartees": ""
    }
}}
<section class="mod_redaction-langue">
    <h3 class="mod_redaction-langue-titre">{{titre}}</h3>
    <dl class="mod_redaction-langue-paliers">
        {{#paliers}}
        <div class="mod_redaction-langue-ligne">
            <dt>{{dimension}}</dt>
            <dd class="mod_redaction-langue-palier{{#bas}} mod_redaction-langue-bas{{/bas}}">{{mot}} ({{sigle}})</dd>
        </div>
        {{/paliers}}
    </dl>
    {{#hasfautes}}
    <h4 class="mod_redaction-langue-soustitre">{{#str}}langue_mots_a_corriger, mod_redaction{{/str}}</h4>
    <ul class="mod_redaction-langue-liste">
        {{#fautes}}
        <li><span class="mod_redaction-langue-cite">{{cite}}</span> <span aria-hidden="true">&rarr;</span>
            <strong class="mod_redaction-langue-correction">{{correction}}</strong>{{#hastype}}
            <span class="mod_redaction-langue-type">({{type}})</span>{{/hastype}}{{#hasfois}}
            <span class="mod_redaction-langue-type">{{fois}}</span>{{/hasfois}}{{#hasregle}}
            <span class="mod_redaction-langue-regle">{{#str}}langue_regle, mod_redaction{{/str}} {{regle}}</span>{{/hasregle}}</li>
        {{/fautes}}
    </ul>
    {{/hasfautes}}
    {{#hasremarques}}
    <h4 class="mod_redaction-langue-soustitre">{{#str}}langue_phrases_a_reprendre, mod_redaction{{/str}}</h4>
    <ul class="mod_redaction-langue-liste">
        {{#remarques}}
        <li><span class="mod_redaction-langue-cite">{{cite}}</span>{{#hastype}}
            <span class="mod_redaction-langue-type">({{type}})</span>{{/hastype}}{{#hasregle}}
            <span class="mod_redaction-langue-regle">{{#str}}langue_regle, mod_redaction{{/str}} {{regle}}</span>{{/hasregle}}</li>
        {{/remarques}}
    </ul>
    {{/hasremarques}}
    {{#hasconseil}}
    <p class="mod_redaction-langue-conseil"><strong>{{#str}}langue_conseil, mod_redaction{{/str}}</strong> {{conseil}}</p>
    {{/hasconseil}}
    {{#hasecartees}}
    <p class="mod_redaction-langue-ecartees">{{ecartees}}</p>
    {{/hasecartees}}
</section>
