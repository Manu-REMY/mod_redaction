{{!
    @template mod_redaction/grading_sujets_overview

    Teacher overview of the assigned subjects mode: one row per group.

    Context variables required for this template:
    * niveau - Name of the level the threshold validates (fragile, satisfaisant…)
    * seuil - Validation threshold
    * individuel - The activity is individual: one row per student
    * hasgroupes, groupes - Rows: etat, etatlibelle (state of the copy, request 16), nom, url, hassystemes, systemes, used, max, hasnote, note, prof, valide,
      pasvalide, aucunenote, hasalerte, alerte

    Example context (json):
    {
        "seuil": "16", "niveau": "fragile", "individuel": false, "hasgroupes": true,
        "groupes": [{"etat": "notee", "etatlibelle": "Rendue, notée", "nom": "4A-GRP01", "url": "#", "hassystemes": true, "systemes": "Train / Barque", "used": 2, "max": 5,
            "hasnote": true, "note": "12", "prof": false, "valide": false, "pasvalide": true, "aucunenote": false,
            "hasalerte": true, "alerte": "The last correction failed."}]
    }
}}
<div class="mod_redaction mod_redaction-sujets-ens" id="mod_redaction-sujets-ens">
    {{^hasgroupes}}
    <p class="mod_redaction-ens-vide">{{#individuel}}{{#str}}sujets_ens_aucun_eleve, mod_redaction{{/str}}{{/individuel}}{{^individuel}}{{#str}}sujets_ens_aucun_groupe, mod_redaction{{/str}}{{/individuel}}</p>
    {{/hasgroupes}}
    {{#hasgroupes}}
    <table class="mod_redaction-ens-table table table-sm">
        <thead>
            <tr>
                <th scope="col">{{#individuel}}{{#str}}sujets_ens_eleve, mod_redaction{{/str}}{{/individuel}}{{^individuel}}{{#str}}group_label, mod_redaction{{/str}}{{/individuel}}</th>
                <th scope="col">{{#individuel}}{{#str}}sujets_ens_sujets, mod_redaction{{/str}}{{/individuel}}{{^individuel}}{{#str}}sujets_ens_systemes, mod_redaction{{/str}}{{/individuel}}</th>
                <th scope="col">{{#str}}sujets_ens_essais, mod_redaction{{/str}}</th>
                <th scope="col">{{#str}}sujets_ens_meilleure, mod_redaction{{/str}}</th>
                <th scope="col">{{#str}}sujets_ens_etat, mod_redaction{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#groupes}}
            <tr>
                <th scope="row"><a href="{{url}}">{{nom}}</a></th>
                <td>{{#hassystemes}}{{systemes}}{{/hassystemes}}{{^hassystemes}}<em>{{#str}}sujets_ens_pas_ouvert, mod_redaction{{/str}}</em>{{/hassystemes}}</td>
                <td>{{used}} / {{max}}</td>
                <td>
                    {{#hasnote}}{{note}}/20{{#prof}} <span class="mod_redaction-ens-tag">{{#str}}sujets_ens_note_prof, mod_redaction{{/str}}</span>{{/prof}}{{/hasnote}}
                    {{^hasnote}}&ndash;{{/hasnote}}
                </td>
                <td>
                    <span class="mod_redaction-ens-copie mod_redaction-ens-copie-{{etat}}">{{etatlibelle}}</span>
                    {{#valide}}<span class="mod_redaction-ens-etat mod_redaction-ens-ok"><span aria-hidden="true">&#10003;</span> {{#str}}sujets_valide, mod_redaction, {{niveau}}{{/str}}</span>{{/valide}}
                    {{#pasvalide}}<span class="mod_redaction-ens-etat mod_redaction-ens-ko"><span aria-hidden="true">&#10007;</span> {{#str}}sujets_pas_valide, mod_redaction, {{niveau}}{{/str}}</span>{{/pasvalide}}
                    {{#aucunenote}}<span class="mod_redaction-ens-etat">{{#str}}sujets_pas_de_note, mod_redaction{{/str}}</span>{{/aucunenote}}
                    {{#hasalerte}}<div class="mod_redaction-ens-alerte" role="alert"><span aria-hidden="true">&#9888;</span> {{alerte}}</div>{{/hasalerte}}
                </td>
            </tr>
            {{/groupes}}
        </tbody>
    </table>
    <p class="mod_redaction-ens-note">{{#str}}sujets_seuil_rappel, mod_redaction, {{seuil}}{{/str}}</p>
    {{/hasgroupes}}
</div>
